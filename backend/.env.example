# ---- Tailoring backend -------------------------------------------------
# Leave LLM_PROVIDER unset (or "auto") to use whichever key you supply:
# Anthropic wins if both are present. Set it explicitly to force one.
# LLM_PROVIDER=claude

# Claude: get a key at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Groq: free tier, no card required: https://console.groq.com/keys
# Note: the free tier has a small per-minute token budget, and a single
# tailoring call can use most of it. Only the gpt-oss models support strict
# schemas.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Database ----------------------------------------------------------
# Local default is SQLite. In production set this to your Postgres URL.
# For Supabase use the *Session pooler* string (Connect, then Session pooler),
# not the direct connection, which is IPv6-only.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# ---- Access control ----------------------------------------------------
# Leave API_KEY unset for local dev (the API is open). In production set it to
# a long random string; every /api request must then send it as X-API-Key.
# The frontend holds this server-side and never ships it to the browser.
# API_KEY=change-me-to-a-long-random-string

# Browser origins allowed to call the API directly (comma-separated).
# CORS_ORIGINS=http://localhost:3000

# ---- Rate limiting -----------------------------------------------------
# Per-client limits on /api: 5/min for the two LLM endpoints, 60/min for the
# rest. On by default. Turn off only for local experiments like load tests.
# RATE_LIMIT_ENABLED=true
# Behind the Next.js proxy every request comes from the proxy's IP. Set this to
# true so the backend uses X-Forwarded-For instead. It is only trusted on
# requests that carry the valid API_KEY, so callers can't spoof it.
# TRUST_FORWARDED_FOR=false
