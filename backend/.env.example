# ---- Tailoring backend -------------------------------------------------
# Leave LLM_PROVIDER unset (or "auto") to use whichever key you supply:
# Anthropic wins if both are present. Set it explicitly to force one.
# LLM_PROVIDER=claude

# Claude: get a key at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Groq: free tier, no card required: https://console.groq.com/keys
# Note: the free tier has a small per-minute token budget, and a single
# tailoring call can use most of it. Only the gpt-oss models support strict
# schemas.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Database ----------------------------------------------------------
# Local default is SQLite. In production set this to your Postgres URL.
# For Supabase use the *Session pooler* string (Connect, then Session pooler),
# not the direct connection, which is IPv6-only.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# ---- Accounts ----------------------------------------------------------
# Every /api request needs a Supabase access token from this project. Unset
# means every /api request is refused. Example: https://<ref>.supabase.co
# SUPABASE_URL=https://your-project-ref.supabase.co

# ---- Proxy key ---------------------------------------------------------
# Optional shared secret between the Next.js proxy and the API. When set,
# every /api request must also send it as X-API-Key, so only the proxy can
# call the API. The frontend holds it server-side, never in the browser.
# API_KEY=change-me-to-a-long-random-string

# Browser origins allowed to call the API directly (comma-separated).
# CORS_ORIGINS=http://localhost:3000

# ---- Rate limiting -----------------------------------------------------
# Per-user limits on /api: 5/min for the two LLM endpoints, 60/min for the
# rest. On by default. Turn off only for local experiments like load tests.
# RATE_LIMIT_ENABLED=true
# Share the buckets across every instance through Redis. Upstash's free tier
# works (use its rediss:// URL). Unset: each process counts on its own. If
# Redis is unreachable, requests are allowed through and an error is logged.
# REDIS_URL=redis://localhost:6379/0
