# Server-side only. The browser never sees these: Next.js route handlers proxy
# every API call and attach the key. Copy to .env.local and fill in.

# Where the FastAPI backend is reachable from the Next.js server.
BACKEND_URL=http://localhost:8000

# Must match the backend's API_KEY. Leave blank for local dev, where the
# backend runs open (no key required).
BACKEND_API_KEY=

# Supabase Auth (Project Settings, then API Keys). Read on the server only, so
# changing them needs no rebuild. The publishable key is safe to expose, but
# nothing here sends it to the browser anyway.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
