# ---- Tailoring backend -------------------------------------------------
# Leave LLM_PROVIDER unset (or "auto") to use whichever key you supply:
# Anthropic wins if both are present. Set it explicitly to force one.
# LLM_PROVIDER=claude

# Claude — get a key at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Groq — free tier, no card required: https://console.groq.com/keys
# Note: the free tier allows only 6,000 tokens/minute, and a single tailoring
# call can use most of that. Only the gpt-oss models support strict schemas.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Database ----------------------------------------------------------
# Local default is SQLite. In production set this to your Postgres URL —
# for Supabase use the *Session pooler* string (Connect → Session pooler),
# not the direct connection, which is IPv6-only.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
