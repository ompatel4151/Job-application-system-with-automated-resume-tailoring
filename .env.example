# Anthropic API key — get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5

# Local default is SQLite. In production set this to your Postgres URL —
# for Supabase use the *Session pooler* string (Connect → Session pooler),
# not the direct connection, which is IPv6-only.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
